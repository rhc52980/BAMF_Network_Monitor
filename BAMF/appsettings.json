{
  "Urls": "http://0.0.0.0:8840",

  "Bamf": {
    // Subnets to scan in CIDR form. Leave the list empty to auto-detect
    // every active IPv4 interface on the server.
    "Subnets": [ "192.168.1.0/24", "192.168.2.0/24" ],

    // Download the full IEEE vendor registry (oui.csv) automatically on
    // first run for complete vendor names. Set false to stay offline.
    "AutoDownloadOui": true,

    // Use active ARP scanning (requires the free Npcap driver from
    // https://npcap.com installed on the server). Catches hosts that ignore
    // ping. If Npcap is missing or a scan fails, BAMF automatically falls
    // back to ping sweep for that cycle.
    "ActiveArpScan": true,

    // Seconds between scans. Used by every network that has no override below.
    "ScanIntervalSeconds": 60,

    // Optional per-network intervals, keyed by the CIDR exactly as written in
    // Subnets above. Anything not listed uses ScanIntervalSeconds. Handy when
    // one network is worth watching closely and another is mostly idle - a
    // wired server VLAN every 30s, a guest network every 10 minutes. Networks
    // run on independent schedules, and a device is only judged offline by a
    // pass that actually scanned its network. Minimum 5 seconds.
    "SubnetScanIntervalSeconds": {
      // "192.168.2.0/24": 30,
      // "10.0.50.0/24": 600
    },

    // How many probes run in parallel during the sweep.
    "PingConcurrency": 64,

    // How many consecutive scans of its network must miss a device before it
    // is called offline. 1 means the first miss counts, which is how BAMF
    // behaved before 1.13. 2 forgives a single hiccup - a laptop waking, a
    // phone dropping Wi-Fi for one sweep - so a watched device doesn't fire
    // an offline alert and a recovery a minute apart. Counted in scans, not
    // minutes, so it means the same thing whatever a network's interval is.
    "OfflineAfterMissedScans": 2,

    // Listen for mDNS announcements on each local network. Devices such as
    // Apple TVs, Chromecasts, Sonos speakers, printers and HomeKit gear
    // announce their own names and services over multicast; BAMF reads what
    // they volunteer and never sends a query. Names learned this way fill in
    // for devices that have no DNS or NetBIOS name, and the services refine
    // the device guess. Can also be switched from the Settings tab.
    "MdnsListen": true,

    // How alerts are delivered to WebhookUrl. "auto" sends a rich embed to a
    // Discord URL and a generic JSON body to anything else. "ntfy" posts plain
    // text with Title, Priority and Tags headers, the way ntfy expects - the
    // URL is your topic, e.g. https://ntfy.sh/bamf-alerts, with an access
    // token in the URL as ?auth=... if the topic needs one. "gotify" posts
    // Gotify's {title, message, priority} JSON to your server's /message URL
    // with the app token as ?token=... . "json" forces the generic body even
    // for a Discord URL. Also chosen in the dashboard's Notifications dialog.
    "WebhookFormat": "auto",

    // Auto-ignore devices using randomized MAC addresses (phones with
    // Wi-Fi privacy enabled). They're still recorded, but hidden under the
    // Ignored tab and never trigger alerts.
    "AutoIgnoreRandomizedMacs": true,

    // After each scan, send one ICMP echo to every online device on the
    // networks it covered and keep the round-trip time, for the Latency column
    // and each device's latency history. One small packet per device per scan.
    // Also on the Settings tab, which wins over this once changed there.
    "LatencyProbe": true,

    // Watch the wire through Npcap, receive-only: bytes in and out per device
    // (a Traffic column and a Top talkers card), and every DHCP and DNS server
    // in use, with an alert when a new DHCP server appears or a device starts
    // asking a DNS server it never used before. Needs the Npcap driver; does
    // nothing without it. On a switched network this machine sees its own
    // traffic plus broadcast and multicast; on a mirrored switch port it sees
    // everything. Also on the Settings tab, which wins over this once changed there.
    "TrafficMonitor": true,

    // Holiday Spirit: every dashboard switches to the Halloween theme from
    // October 1st to 31st and to the Christmas theme from December 1st to
    // 25th, then back to its own theme on November 1st and December 26th.
    // Also on the Settings tab, which wins over this once changed there.
    "HolidaySpirit": false,

    // Optional: webhook called when an unknown host appears.
    // Receives JSON: { "mac": "...", "ip": "...", "hostname": "...", "vendor": "..." }
    // Works with Discord ("content" is also included), ntfy, or anything generic.
    "WebhookUrl": "",

    // Optional: presence per device over MQTT, for Home Assistant. Set Server
    // to turn it on. Each device becomes a retained "home" / "not_home" on
    // <TopicPrefix>/<mac>/state with its details on .../attributes, and with
    // Discovery on, Home Assistant picks each one up as a device_tracker by
    // itself (under <DiscoveryPrefix>/device_tracker/...). Set here only, and
    // read at startup, since the broker password has no business in the
    // dashboard. Tls true for a broker on 8883.
    "Mqtt": {
      "Server": "",
      "Port": 1883,
      "Tls": false,
      "Username": "",
      "Password": "",
      "ClientId": "bamf",
      "TopicPrefix": "bamf",
      "Discovery": true,
      "DiscoveryPrefix": "homeassistant"
    },

    // Optional: a token for the inbound webhooks (POST /api/hooks/scan and
    // /api/hooks/wake/{mac}), for Home Assistant and scripts. Sent as an
    // X-BAMF-Token header or ?token=. With a Password set, the token stands in
    // for it on those two endpoints; without one, they are as open as the rest.
    "HookToken": "",

    // Optional: other BAMF servers to show in this dashboard, read-only. Each
    // remote's devices appear under networks named after it. Password is the
    // remote's Bamf:Password, if it has one.
    "Remotes": [
      // { "Name": "Cabin", "Url": "http://10.0.0.5:8840", "Password": "" }
    ],

    // Optional: read device names from your router every hour. Kind is one
    // of openwrt, opnsense, pfsense or unifi; empty leaves it off. See the
    // README's "Names from your router" for what each one needs.
    "RouterImport": {
      "Kind": "",
      "Url": "",
      "Username": "",
      "Password": "",
      "ApiKey": "",
      "ApiSecret": "",
      "Site": "default",
      "IntervalMinutes": 60,
      "VerifyCertificate": false
    },

    // Optional: require this password to open the UI (HTTP Basic auth,
    // any username). Leave empty to disable auth.
    "Password": "",

    // Optional, with Password set: a second password that opens the same
    // dashboard to look at but not change. For family, or the wall display.
    "ViewerPassword": "",

    // Where a device's IP link points when that device has no link of its own.
    // "{ip}" is replaced with the device address. Examples:
    //   "http://{ip}"        default - the device's web UI on port 80
    //   "https://{ip}"       everything speaks HTTPS
    //   "http://{ip}:8080"   an alternate web port
    // Individual devices can override this from their row's ... menu.
    "DeviceLinkTemplate": "http://{ip}",

    // Check GitHub once a day for a newer release and show a badge in the
    // dashboard header. Off by default: BAMF often runs on isolated networks,
    // and this is the only outbound call it would make that you didn't ask
    // for. It never downloads or installs anything. There's a toggle in the
    // dashboard header too, which overrides this value.
    "UpdateCheck": false,

    // Repository the update check looks at. Change it if you run a fork.
    "UpdateRepo": "rhc52980/BAMF_Network_Monitor",

    // How many days of online/offline history to keep (pruned daily).
    "HistoryRetentionDays": 90,

    // SQLite database file path (relative to the app folder).
    "DatabasePath": "bamf.db"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
